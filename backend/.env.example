# =================================================================
# Clipping Creator Backend — Environment Configuration
# =================================================================

# -----------------------------------------------------------------
# 1. AssemblyAI API Key (Required for transcription & AI virality analysis)
# Get a free key at: https://www.assemblyai.com/
# -----------------------------------------------------------------
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# -----------------------------------------------------------------
# 2. Google Cloud Platform (Optional for local testing, Required for Production)
# -----------------------------------------------------------------
GCP_PROJECT_ID=your_gcp_project_id_here
GCS_BUCKET_NAME=clippingcreator-media-bucket

# Path to your GCP Service Account JSON key
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -----------------------------------------------------------------
# 3. Server Configuration
# -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# -----------------------------------------------------------------
# 4. Processing Settings
# -----------------------------------------------------------------
MAX_VIDEO_DURATION=3600
CLIP_STORAGE_DAYS=7
FFMPEG_PATH=ffmpeg
TEMP_DIR=/tmp/clipping

# Optional: Path to caption font (.ttf) for rendering
# Linux/Docker default: /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# Windows fallback: C:/Windows/Fonts/arialbd.ttf
# CAPTION_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
